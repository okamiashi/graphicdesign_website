// Convert to HTML string grouped by date
let changelogHTML = "";
let lastDate = "";
changeLog.forEach(change => {
    if (change.date !== lastDate) {
        if (lastDate) changelogHTML += "</ul>"; // close previous date's list
        changelogHTML += `<h3>${change.date}</h3><ul>`; // new date header + list
        lastDate = change.date;
    }
    changelogHTML += `<li>${change.text}</li>`;
});
changelogHTML += "</ul>"; // close last list




// Take the most recent update date and format only the changes of said date.
latestUpdateObj = changeLog[0]; //assuming I'm not an idiot and changeLog is sorted correctly

const recentChanges = changeLog
  .filter(c => c.date === latestUpdateObj.date)
  .map((c, i) => `${i + 1}. ${c.text}<br>`)
  .join("");




//Calculate lastUpdated from latestUpdateObj's mm/dd/yy into longm ddth, yyyy
const dateStr = latestUpdateObj.date;
const [month, day, year] = dateStr.split("/");

// Convert 2-digit year to 4-digit (assumes 2000s)
const fullYear = 2000 + Number(year);

const date = new Date(fullYear, month - 1, day);

const lastUpdated = date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric"
});











